#!/usr/bin/env bash
# =============================================================================
# Retro OS v1.0 - /usr/local/bin/retro
# Standalone CLI orchestrator. Installed by install.sh.
# =============================================================================
set -Eeuo pipefail

# When installed, config.env lives alongside the other project files under
# RETRO_ROOT. Fall back gracefully if it's missing so `retro` never hard-crashes
# on a system where only this single file was copied.
RETRO_ROOT_DEFAULT="/opt/retro-os"
if [[ -f "${RETRO_ROOT_DEFAULT}/config.env" ]]; then
    # shellcheck source=/opt/retro-os/config.env
    source "${RETRO_ROOT_DEFAULT}/config.env"
else
    # Minimal inline fallback so the CLI still works standalone.
    export TARGET_USER="${SUDO_USER:-${USER:-root}}"
    export TARGET_HOME="${HOME:-/root}"
    export RETRO_BURNER_DIR="/mnt/burner"
    export RETRO_SNAP_DIR="/var/lib/retro-os/snapshots"
    export RETRO_TOR_SERVICE="tor"
    export C_RESET='\033[0m'; export C_RED='\033[0;31m'; export C_GREEN='\033[0;32m'
    export C_YELLOW='\033[0;33m'; export C_CYAN='\033[0;36m'; export C_BOLD='\033[1m'
    retro_info()  { echo -e "${C_CYAN}[*]${C_RESET} $*"; }
    retro_ok()    { echo -e "${C_GREEN}[+]${C_RESET} $*"; }
    retro_warn()  { echo -e "${C_YELLOW}[!]${C_RESET} $*"; }
    retro_error() { echo -e "${C_RED}[x]${C_RESET} $*"; }
    retro_die()   { retro_error "$@"; exit 1; }
    is_command()  { command -v "$1" >/dev/null 2>&1; }
    is_btrfs_root(){ [[ "$(findmnt -n -o FSTYPE / 2>/dev/null)" == "btrfs" ]]; }
fi

export RETRO_VERSION="${RETRO_OS_VERSION:-1.1}"

# -----------------------------------------------------------------------------
# Helper: require a real (non-root-owned-only) desktop session for GUI bits
# -----------------------------------------------------------------------------
_need_display() {
    if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${DISPLAY:-}" ]]; then
        retro_warn "No WAYLAND_DISPLAY or DISPLAY detected - attempting X11 fallback via xhost/DISPLAY=:0"
        export DISPLAY="${DISPLAY:-:0}"
    fi
}

