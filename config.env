#!/usr/bin/env bash
# =============================================================================
# Retro OS v1.0 - config.env
# Centralized configuration sourced by every script in this project.
# This file must be SOURCED, never executed directly.
# =============================================================================

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "config.env must be sourced, not executed directly." >&2
    exit 1
fi

if [[ -n "${RETRO_CONFIG_LOADED:-}" ]]; then
    return 0
fi
export RETRO_CONFIG_LOADED=1

set -Eeuo pipefail

# -----------------------------------------------------------------------------
# Target user resolution (fixes crashes when $SUDO_USER is empty, e.g. when
# running as root directly, via su, or inside a live-build chroot)
# -----------------------------------------------------------------------------
export TARGET_USER="${SUDO_USER:-${USER:-root}}"

if [[ "${TARGET_USER}" == "root" ]]; then
    export TARGET_HOME="/root"
else
    _resolved_home="$(getent passwd "${TARGET_USER}" 2>/dev/null | cut -d: -f6)"
    export TARGET_HOME="${_resolved_home:-/home/${TARGET_USER}}"
    unset _resolved_home
fi

export SKEL_DIR="/etc/skel"

# -----------------------------------------------------------------------------
# Project paths
# -----------------------------------------------------------------------------
export RETRO_ROOT="/opt/retro-os"
export RETRO_BIN_DIR="/usr/local/bin"
export RETRO_ETC_DIR="/etc/retro-os"
export RETRO_LOG_DIR="/var/log/retro-os"
export RETRO_LOG_FILE="${RETRO_LOG_DIR}/retro-os.log"
export RETRO_STATE_DIR="/var/lib/retro-os"
export RETRO_SNAP_DIR="${RETRO_STATE_DIR}/snapshots"
export RETRO_BURNER_DIR="/mnt/burner"
export RETRO_TOR_SERVICE="tor"

# -----------------------------------------------------------------------------
# Theme / branding
# -----------------------------------------------------------------------------
export RETRO_OS_NAME="Retro OS"
export RETRO_OS_VERSION="1.1"
export RETRO_ACCENT_COLOR="#00FF9C"
export RETRO_BG_COLOR="#0D0F12"
export RETRO_FG_COLOR="#E0E0E0"
export RETRO_FONT_NAME="JetBrainsMono Nerd Font"
export RETRO_ICON_THEME="Papirus-Dark"

# -----------------------------------------------------------------------------
# Terminal color codes (script output only)
# -----------------------------------------------------------------------------
export C_RESET='\033[0m'
export C_RED='\033[0;31m'
export C_GREEN='\033[0;32m'
export C_YELLOW='\033[0;33m'
export C_BLUE='\033[0;34m'
export C_CYAN='\033[0;36m'
export C_BOLD='\033[1m'

# -----------------------------------------------------------------------------
# Shared logging helpers
# -----------------------------------------------------------------------------
retro_log() {
    local level="$1"; shift
    local msg="$*"
    local ts
    ts="$(date '+%Y-%m-%d %H:%M:%S')"
    mkdir -p "${RETRO_LOG_DIR}" 2>/dev/null || true
    echo "[${ts}] [${level}] ${msg}" >> "${RETRO_LOG_FILE}" 2>/dev/null || true

    case "${level}" in
        INFO)  echo -e "${C_CYAN}[*]${C_RESET} ${msg}" ;;
        OK)    echo -e "${C_GREEN}[+]${C_RESET} ${msg}" ;;
        WARN)  echo -e "${C_YELLOW}[!]${C_RESET} ${msg}" ;;
        ERROR) echo -e "${C_RED}[x]${C_RESET} ${msg}" ;;
        *)     echo -e "${msg}" ;;
    esac
}

retro_info()  { retro_log INFO  "$@"; }
retro_ok()    { retro_log OK    "$@"; }
retro_warn()  { retro_log WARN  "$@"; }
retro_error() { retro_log ERROR "$@"; }
retro_die()   { retro_error "$@"; exit 1; }

# -----------------------------------------------------------------------------
# Common guards / helpers
# -----------------------------------------------------------------------------
require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        retro_die "This script must be run as root (use sudo)."
    fi
}

is_btrfs_root() {
    local fstype
    fstype="$(findmnt -n -o FSTYPE / 2>/dev/null || echo unknown)"
    [[ "${fstype}" == "btrfs" ]]
}

is_command() {
    command -v "$1" >/dev/null 2>&1
}

# Run a command as TARGET_USER whether we're root or not, and without
# requiring an interactive sudo prompt (safe in chroot/live-build too).
run_as_target_user() {
    if [[ "${EUID}" -eq 0 && "${TARGET_USER}" != "root" ]]; then
        runuser -u "${TARGET_USER}" -- "$@"
    else
        "$@"
    fi
}

mkdir -p "${RETRO_LOG_DIR}" "${RETRO_STATE_DIR}" "${RETRO_SNAP_DIR}" "${RETRO_ETC_DIR}" 2>/dev/null || true

require_root_soft() {
    if [[ "${EUID}" -ne 0 ]]; then
        retro_die "This action requires root. Re-run with: sudo retro $*"
    fi
}

